generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  userId        String        @id @default(uuid())
  email         String        @unique
  phone         String        @unique
  passwordHash  String
  role          Role          @default(CITIZEN)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  lastLogin     DateTime?
  appointments1 Appointment[] @relation("CitizenAppointments")
  appointments2 Appointment[] @relation("OfficerAppointments")
  officerTransfers TransferRequest[] @relation("OfficerApprovedTransfers")
  auditLogs     AuditLog[]
  owner         Owner?
}

model Owner {
  ownerId        String            @id @default(uuid())
  userId         String            @unique
  fullName       String
  nationalId     String            @unique
  phone          String
  address        String
  landParcels    LandParcel[]
  user           User              @relation(fields: [userId], references: [userId])
  transferBuyer  TransferRequest[] @relation("BuyerTransfers")
  transferSeller TransferRequest[] @relation("SellerTransfers")
  historyPrevious OwnershipHistory[] @relation("PreviousOwnerHistory")
  historyNew      OwnershipHistory[] @relation("NewOwnerHistory")
}

model LandParcel {
  parcelId         String                    @id @default(uuid())
  parcelNumber     String                    @unique
  currentOwnerId   String
  boundary         Unsupported("geography")?
  sizeSqm          Float
  landUseType      LandUseType
  kebele           String
  registrationDate DateTime                  @default(now())
  status           ParcelStatus              @default(ACTIVE)
  gisData          GISData[]
  currentOwner     Owner                     @relation(fields: [currentOwnerId], references: [ownerId])
  taxRecords       TaxRecord[]
  transferRequests TransferRequest[]
  ownershipHistory OwnershipHistory[]
}

model TransferRequest {
  requestId           String         @id @default(uuid())
  trackingId          String         @unique
  parcelId            String
  sellerId            String
  buyerId             String
  salePrice           Float
  status              TransferStatus @default(DRAFT)
  documents           Json
  officerComments     String?
  requestedAt         DateTime       @default(now())
  approvedAt          DateTime?
  approvedByOfficerId String?
  buyer               Owner          @relation("BuyerTransfers", fields: [buyerId], references: [ownerId])
  parcel              LandParcel     @relation(fields: [parcelId], references: [parcelId])
  seller              Owner          @relation("SellerTransfers", fields: [sellerId], references: [ownerId])
  officer             User?          @relation("OfficerApprovedTransfers", fields: [approvedByOfficerId], references: [userId])
}

model OwnershipHistory {
  historyId           String      @id @default(uuid())
  parcelId            String
  previousOwnerId     String
  newOwnerId          String
  transferRequestId   String?
  transferPrice       Float?
  deedReference       String?
  recordedAt          DateTime    @default(now())
  recordedByUserId    String
  parcel              LandParcel  @relation(fields: [parcelId], references: [parcelId])
  previousOwner       Owner       @relation("PreviousOwnerHistory", fields: [previousOwnerId], references: [ownerId])
  newOwner            Owner       @relation("NewOwnerHistory", fields: [newOwnerId], references: [ownerId])
}

model TaxRecord {
  taxId         String     @id @default(uuid())
  parcelId      String
  taxYear       Int
  baseAmount    Float
  surcharge     Float      @default(0)
  penalty       Float      @default(0)
  totalAmount   Float
  paidAmount    Float      @default(0)
  status        TaxStatus  @default(UNPAID)
  paymentDate   DateTime?
  receiptNumber String?
  parcel        LandParcel @relation(fields: [parcelId], references: [parcelId])
}

model Appointment {
  appointmentId String            @id @default(uuid())
  citizenId     String
  officerId     String
  serviceType   ServiceType
  dateTime      DateTime
  status        AppointmentStatus @default(BOOKED)
  paymentStatus Boolean           @default(false)
  citizen       User              @relation("CitizenAppointments", fields: [citizenId], references: [userId])
  officer       User              @relation("OfficerAppointments", fields: [officerId], references: [userId])
}

model AuditLog {
  logId        String   @id @default(uuid())
  timestamp    DateTime @default(now())
  userId       String?
  ipAddress    String?
  action       String
  entityType   String
  entityId     String
  oldValue     Json?
  newValue     Json?
  hash         String
  previousHash String
  user         User?    @relation(fields: [userId], references: [userId])
}

model GISData {
  gisId              String                    @id @default(uuid())
  parcelId           String
  geometry           Unsupported("geography")?
  sourceFile         String
  uploadedBy         String
  verificationStatus VerificationStatus        @default(PENDING)
  parcel             LandParcel                @relation(fields: [parcelId], references: [parcelId])
}

model PaymentTransaction {
  transactionId String        @id @default(uuid())
  referenceNo   String        @unique
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  relatedEntity String
  relatedId     String
  receiptUrl    String?
  createdAt     DateTime      @default(now())
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  CITIZEN
  LAND_OFFICER
  TAX_OFFICIAL
  GIS_OFFICER
  ADMIN
}

enum LandUseType {
  RESIDENTIAL
  COMMERCIAL
  AGRICULTURAL
  INDUSTRIAL
  MIXED_USE
}

enum ParcelStatus {
  ACTIVE
  TRANSFERRED
  DISPUTED
  TAX_HOLD
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  TAX_VERIFIED
  TAX_HOLD
  UNDER_REVIEW
  ADDITIONAL_DOCS_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum TaxStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERPAID
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VerificationStatus {
  PENDING
  VERIFIED
  OVERLAP_DETECTED
}

enum PaymentMethod {
  TELEBIRR
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum ServiceType {
  LAND_REGISTRATION
  TRANSFER_APPROVAL
  DOCUMENT_VERIFICATION
  TAX_QUERY
}
