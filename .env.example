# Application runtime
NODE_ENV=development
API_PORT=4000

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL/PostGIS. Use docker-compose up -d db for a local instance, or
# replace with your own Postgres URL. Do not commit real production credentials.
DATABASE_URL=postgresql://dlpms_user:change_me@localhost:5432/dlpms?schema=public

# JWT signing secret for HS256. MUST be at least 32 characters of high entropy.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret_value_minimum_32_chars

# Identity / OTP
OTP_MAX_ATTEMPTS=5
REQUIRE_OTP_ON_LOGIN=false

# Payment webhook signature validation (HMAC-SHA256). Used by the mock telebirr
# adapter. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=replace_me_with_a_long_random_webhook_secret_value

# Public base URL embedded in certificate QR codes (the verification endpoint).
# In production this is the externally reachable API URL.
PUBLIC_BASE_URL=http://localhost:4000

# Local filesystem storage root for uploaded documents (mock adapter; per
# AGENTS.md, file storage integrations are adapter-based and start with mock
# implementations). Production swaps this for S3/NAS without changing the
# DocumentMetadata schema (storage_adapter + storage_key remain stable).
STORAGE_ROOT=/home/z/my-project/storage/dlpms-docs
