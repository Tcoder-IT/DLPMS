classDiagram
    class User {
        +UUID userId
        +String phoneNumber
        +String email
        +String passwordHash
        +Enum role
        +Boolean isActive
        +authenticate()
        +updateProfile()
        +deactivate()
    }

    class Owner {
        +String ownerId
        +String fullName
        +String identityDocument
        +registerProperty()
    }
    
    User <|-- Owner : inherits

    class LandParcel {
        +String parcelId
        +Float area
        +String location
        +Geometry boundary
        +calculateTax()
    }

    class TaxRecord {
        +String taxId
        +Float amountDue
        +Float amountPaid
        +String status
        +recordPayment()
    }

    class LandRegistry {
        +String registryId
        +Date registrationDate
        +String historicalChain
        +updateRecord()
    }

    class TransferRequest {
        +String requestId
        +Date submissionDate
        +String status
        +submit()
        +approve()
        +reject()
    }

    class Appointment {
        +String appointmentId
        +Date scheduledTime
        +String status
        +book()
        +cancel()
    }

    class AuditLog {
        +String logId
        +Date timestamp
        +String actionType
        +String snapshotBefore
        +String snapshotAfter
        +String hash
        +verifyIntegrity()
    }

    class PaymentTransaction {
        +String transactionId
        +Float amount
        +Date paymentDate
        +String method
        +processWebhook()
    }

    class GISService {
        <<utility>>
        +verifyBoundary()
        +renderMap()
    }

    Owner "1" *-- "*" LandParcel : composes
    LandParcel "1" *-- "1" TaxRecord : composes
    LandParcel "1" -- "1" LandRegistry : associated with
    
    TransferRequest "*" -- "1" Owner : Seller
    TransferRequest "*" -- "1" User : Buyer
    TransferRequest "*" -- "1" LandParcel : Subject
    
    Appointment "*" -- "1" Owner : Books
    Appointment "*" -- "1" User : Handled By
    
    AuditLog "*" ..> "1" User : references
    
    PaymentTransaction "*" -- "1" TaxRecord : pays
    PaymentTransaction "*" -- "1" Owner : initiated by
    
    GISService ..> LandParcel : uses
