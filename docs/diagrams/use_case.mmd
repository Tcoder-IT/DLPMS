    LandOfficer --> UC14
    LandOfficer --> UC15
    LandOfficer --> UC16

    UC13 -.->|<<include>>| UC12
    UC11 -.->|<<extend>>| UC_UploadBound

    TaxOfficial --> UC17
    TaxOfficial --> UC18
    TaxOfficial --> UC19
    TaxOfficial --> UC_Receipt
    TaxOfficial --> UC20

    GISOfficer --> UC_UploadBound
    GISOfficer --> UC22
    GISOfficer --> UC23

    Admin --> UC24
    Admin --> UC25
    Admin --> UC26
    Admin --> UC27

    classDef actor fill:#f9f,stroke:#333,stroke-width:2px;
    class Citizen,LandOfficer,TaxOfficial,GISOfficer,Admin actor;
